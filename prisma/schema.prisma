generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum SellingMode {
  in_stock
  preorder
  out_of_stock
}

enum OrderStatus {
  new
  confirmed
  packed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  bank_transfer
  instagram
}

enum OrderChannel {
  site
  instagram
}

enum AddressKind {
  yerevan
  marz
}

enum AdminRole {
  owner
  manager
  staff
}

enum PurchaseStatus {
  draft
  ordered
  received
  cancelled
}

enum ReturnStatus {
  requested
  received
  refunded
  rejected
}

enum CouponKind {
  percent
  fixed
}

enum Season {
  three_season
  winter
  all_season
}

model Category {
  id       String     @id @default(cuid())
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  slug     String     @unique
  name     Json
  sort     Int        @default(0)
  imageUrl String?
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String         @id @default(cuid())
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id])
  slug        String         @unique
  name        Json
  description Json
  published   Boolean        @default(true)
  brandId     String?
  brand       Brand?         @relation(fields: [brandId], references: [id])
  tagline     Json?
  specs       Json?
  season      Season?
  features    String[]       @default([])
  featured    Boolean        @default(false)
  ratingAvg   Float?
  ratingCount Int            @default(0)
  variants    Variant[]
  images      ProductImage[]
}

model Variant {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String         @unique
  priceAmd      Int
  stockQty      Int            @default(0)
  sellingMode   SellingMode
  preorderLimit Int?
  barcode       String?
  costAmd       Int            @default(0)
  label         Json
  images        ProductImage[]
  cartItems     CartItem[]
  orderLines    OrderLine[]
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  url       String
  sort      Int      @default(0)
}

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int

  @@unique([cartId, variantId])
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique
  customerName   String
  phone          String
  email          String?
  addressKind    AddressKind
  district       String
  addressLine    String
  paymentMethod  PaymentMethod
  status         OrderStatus   @default(new)
  channel        OrderChannel
  clubCodeId     String?
  clubCode       ClubCode?     @relation(fields: [clubCodeId], references: [id])
  cashbackAmd    Int           @default(0)
  deliveryFeeAmd Int           @default(0)
  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  placedAt       DateTime      @default(now())
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  discountAmd    Int           @default(0)
  lines          OrderLine[]
  returns        ReturnOrder[]
}

model OrderLine {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        Variant     @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  qty            Int
  priceAmd       Int
  sellingMode    SellingMode
  promisedShipOn DateTime?
}

model ClubPartner {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  logoUrl     String?
  accent      String
  cashbackBps Int        @default(0)
  validUntil  DateTime
  message     String     @default("")
  codes       ClubCode[]
}

model ClubCode {
  id        String      @id @default(cuid())
  partnerId String
  partner   ClubPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code      String      @unique
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  orders    Order[]
}

model DeliveryZone {
  id     String  @id @default(cuid())
  name   Json
  feeAmd Int
  etaDays Int
  orders Order[]
}

model Page {
  id    String @id @default(cuid())
  slug  String @unique
  title Json
  body  Json
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         AdminRole @default(owner)
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  movements StockMovement[]
  purchases PurchaseOrder[]
}

model StockMovement {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])
  qty         Int
  reason      String
  ref         String?
  createdAt   DateTime  @default(now())
}

model Supplier {
  id       String          @id @default(cuid())
  name     String
  email    String?
  phone    String?
  notes    String          @default("")
  orders   PurchaseOrder[]
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  number      String         @unique
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  status      PurchaseStatus @default(draft)
  createdAt   DateTime       @default(now())
  lines       PurchaseLine[]
}

model PurchaseLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant       @relation(fields: [variantId], references: [id])
  qty       Int
  costAmd   Int
}

model ReturnOrder {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  status    ReturnStatus @default(requested)
  restock   Boolean      @default(true)
  note      String       @default("")
  refundAmd Int          @default(0)
  createdAt DateTime     @default(now())
  lines     ReturnLine[]
}

model ReturnLine {
  id          String      @id @default(cuid())
  returnId    String
  returnOrder ReturnOrder @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLineId String
  qty         Int
}

model Coupon {
  id       String     @id @default(cuid())
  code     String     @unique
  kind     CouponKind
  value    Int
  startsAt DateTime?
  endsAt   DateTime?
  active   Boolean    @default(true)
  orders   Order[]
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  amountAmd Int
  spentOn   DateTime @default(now())
  note      String   @default("")
}
